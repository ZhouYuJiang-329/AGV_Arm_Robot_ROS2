<launch>
    <arg name="chassis_ip" default="192.168.1.109"/>
    <arg name="enable_lidar" default="false"/>
    <arg name="use_sim_time" default="false"/>
    <arg name="lidar_params_file" default="$(find-pkg-share lidar)/config/seer_lidar.yaml"/>
    <arg name="agv_max_linear_speed" default="0.0"/>
    <arg name="agv_max_angular_speed" default="0.0"/>
    <arg name="agv_init_set_do" default="true"/>
    <arg name="agv_init_do_id" default="0"/>
    <arg name="agv_init_do_status" default="true"/>
    <arg name="agv_init_relocate" default="true"/>

    <let name ="urdf_path"
         value="$(find-pkg-share agv_description)/urdf/agv_robot.urdf.xacro"/>
    <let name ="rviz_config_path"
         value="$(find-pkg-share agv_bringup)/config/agv_moveit.rviz"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
                value="$(command 'xacro $(var urdf_path) chassis_ip:=$(var chassis_ip) agv_max_linear_speed:=$(var agv_max_linear_speed) agv_max_angular_speed:=$(var agv_max_angular_speed) agv_init_set_do:=$(var agv_init_set_do) agv_init_do_id:=$(var agv_init_do_id) agv_init_do_status:=$(var agv_init_do_status) agv_init_relocate:=$(var agv_init_relocate)')" />
    </node>

    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share agv_bringup)/config/ros2_controllers.yaml" />
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />
    <node pkg="controller_manager" exec="spawner" args="agvBase_controller" />
    <node pkg="controller_manager" exec="spawner" args="arm1_controller" />
    <node pkg="controller_manager" exec="spawner" args="arm2_controller" />
    <!-- <node pkg="camera" exec="camera_node" /> -->

    <include if="$(var enable_lidar)" file="$(find-pkg-share lidar)/launch/seer_lidar.launch.py">
        <arg name="connection" value="$(var chassis_ip)"/>
        <arg name="params_file" value="$(var lidar_params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <include file="$(find-pkg-share agv_moveit_config)/launch/move_group.launch.py" />

    <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_path)"/>
</launch>
