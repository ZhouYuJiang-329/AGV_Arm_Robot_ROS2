<launch>
    <arg name="navigation_mode" default="false"/>
    <arg name="navigation_guard_params" default="$(find-pkg-share robot_move)/config/navigation_guard.yaml"/>
    <arg name="chassis_ip" default="192.168.1.109"/>
    <arg name="front_lidar_tf_owner" default="off"/>
    <arg name="back_lidar_tf_owner" default="off"/>
    <arg name="lidar_mounts_file" default="$(find-pkg-share agv_description)/config/lidar_mounts.yaml"/>
    <arg name="enable_odometry" default="false"/>
    <arg name="odometry_publish_tf" default="true"/>
    <arg name="odometry_params_file" default="$(find-pkg-share robot_move)/config/seer_odometry.yaml"/>
    <arg name="enable_lidar" default="false"/>
    <arg name="use_sim_time" default="false"/>
    <arg name="lidar_params_file" default="$(find-pkg-share lidar)/config/seer_lidar.yaml"/>
    <arg name="agv_max_linear_speed" default="0.0"/>
    <arg name="agv_max_angular_speed" default="0.0"/>
    <arg name="agv_init_set_do" default="true"/>
    <arg name="agv_init_do_id" default="0"/>
    <arg name="agv_init_do_status" default="true"/>
    <arg name="agv_init_relocate" default="true"/>

    <let name ="rviz_config_path"
         value="$(find-pkg-share agv_bringup)/config/agv_moveit.rviz"/>

    <include file="$(find-pkg-share agv_description)/launch/robot_description.launch.py">
        <arg name="external_navigation" value="$(var navigation_mode)"/>
        <arg name="model" value="full"/>
        <arg name="front_lidar_tf_owner" value="$(var front_lidar_tf_owner)"/>
        <arg name="back_lidar_tf_owner" value="$(var back_lidar_tf_owner)"/>
        <arg name="lidar_mounts_file" value="$(var lidar_mounts_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="chassis_ip" value="$(var chassis_ip)"/>
        <arg name="agv_max_linear_speed" value="$(var agv_max_linear_speed)"/>
        <arg name="agv_max_angular_speed" value="$(var agv_max_angular_speed)"/>
        <arg name="agv_init_set_do" value="$(var agv_init_set_do)"/>
        <arg name="agv_init_do_id" value="$(var agv_init_do_id)"/>
        <arg name="agv_init_do_status" value="$(var agv_init_do_status)"/>
        <arg name="agv_init_relocate" value="$(var agv_init_relocate)"/>
    </include>

    <include if="$(var navigation_mode)" file="$(find-pkg-share robot_move)/launch/navigation_guard.launch.py">
        <arg name="connection" value="$(var chassis_ip)"/>
        <arg name="params_file" value="$(var navigation_guard_params)"/>
    </include>

    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share agv_bringup)/config/ros2_controllers.yaml" />
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />
    <node pkg="controller_manager" exec="spawner" args="agvBase_controller" />
    <node pkg="controller_manager" exec="spawner" args="arm1_controller" />
    <node pkg="controller_manager" exec="spawner" args="arm2_controller" />
    <!-- <node pkg="camera" exec="camera_node" /> -->

    <include if="$(var enable_odometry)" file="$(find-pkg-share robot_move)/launch/seer_odometry.launch.py">
        <arg name="connection" value="$(var chassis_ip)"/>
        <arg name="params_file" value="$(var odometry_params_file)"/>
        <arg name="publish_tf" value="$(var odometry_publish_tf)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <include if="$(var enable_lidar)" file="$(find-pkg-share lidar)/launch/seer_lidar.launch.py">
        <arg name="connection" value="$(var chassis_ip)"/>
        <arg name="params_file" value="$(var lidar_params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <include file="$(find-pkg-share agv_moveit_config)/launch/move_group.launch.py" />

    <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_path)"/>
</launch>
